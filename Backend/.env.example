# MongoDB Atlas connection string (used by config/db.js, feedback/notification/marketplace/society/event models)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>

# Supabase Postgres connection string (used by Prisma, src/config/prisma.js)
# Most controllers (auth, donor, request, roommate, lostItem, administrator, etc.) read/write through this.
DATABASE_URL=postgresql://<user>:<password>@<supabase-host>:5432/<db-name>

# Auth
JWT_SECRET=change-me

# Gmail (used for outgoing notification emails, src/config/gmailConfig.js)
GMAIL_USER=your-app@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Deployment
# Allowed CORS origin(s) - your Vercel URL, comma-separated for several (no trailing slash)
FRONTEND_URL=http://localhost:5173
# Full firebase-admin service-account JSON on one line (used instead of firebase.admin.json)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Render sets PORT automatically; only needed locally if not 4000
# PORT=4000
